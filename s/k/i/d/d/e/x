local strLower = string.lower
local strMatch = string.match

local function get()
 local targetOption = Options and Options.TargetName
 if not targetOption then return nil end

 local targetVal = targetOption.Value
 if not targetVal then return nil end

 if type(targetVal) == "table" then
  for k, v in pairs(targetVal) do
   if v then
    targetVal = k
    break
   end
  end
 end

 if type(targetVal) == "string" and targetVal ~= "" then
  if isMM2 then
   if targetVal == "Murderer" then
    for p, data in pairs(cachedRoles) do
     if data.Role == "Murderer" and not data.Dead then return p end
    end
    return nil
   elseif targetVal == "Sheriff" then
    for p, data in pairs(cachedRoles) do
     if data.Role == "Sheriff" and not data.Dead then return p end
    end
    return nil
   end
  end

  local extractedName = strMatch(targetVal, "%(@([^%)]+)%)")
  if extractedName then targetVal = extractedName end

  local targetPlayer = Players:FindFirstChild(targetVal)
  if targetPlayer then return targetPlayer end

  local lowerName = strLower(targetVal)
  for _, p in ipairs(Players:GetPlayers()) do
   if strLower(p.Name) == lowerName or strLower(p.DisplayName) == lowerName then
    return p
   end
  end
 elseif typeof(targetVal) == "Instance" and targetVal:IsA("Player") then
  return targetVal
 end

 return nil
end

